# Copy this file to .env.local and fill in real values.
# Everything in .env* except this example file is git-ignored.

# ------------------------------------------------------------------
# Application
# ------------------------------------------------------------------
APP_NAME="GOS Store"

# Absolute URL of this deployment (client-side fetches, canonical links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------
# Data access
# ------------------------------------------------------------------
# Pick where product data lives. `memory` needs no infrastructure.
# REPOSITORY_MODE=memory
# REPOSITORY_MODE=database

# Required (validated at boot) as soon as REPOSITORY_MODE is `database`
# DATABASE_URL=postgres://user:password@localhost:5432/gos
