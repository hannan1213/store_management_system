# Copy this file to .env and fill in real values.
# Everything in .env* except this example file is git-ignored.

# ------------------------------------------------------------------
# Application
# ------------------------------------------------------------------
APP_NAME="GOS Store"

# Absolute URL of this deployment (client-side fetches, canonical links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------
# Data access
# ------------------------------------------------------------------
# `database` uses PostgreSQL through Prisma. `memory` is the zero-infra fallback.
REPOSITORY_MODE=database

# Required when REPOSITORY_MODE=database.
# Local dev (npm run db:up): postgres / postgres on port 5432, database gos_dev.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/gos_dev?schema=public
